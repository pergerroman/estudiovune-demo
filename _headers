/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self' https://www.googletagmanager.com; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://www.googletagmanager.com https://*.google-analytics.com; connect-src 'self' https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com; form-action 'self' https://wa.me; upgrade-insecure-requests

/
  Cache-Control: public, max-age=0, must-revalidate

/404.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Robots-Tag: noindex, follow, nosnippet

/robots.txt
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600

/css/*
  Cache-Control: public, max-age=0, must-revalidate

/js/*
  Cache-Control: public, max-age=0, must-revalidate

/js/vendor/three-r128.min.js
  Cache-Control: public, max-age=31536000, immutable

/src/*
  Cache-Control: public, max-age=604800

/favicon.ico
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800

/docs/*
  X-Robots-Tag: noindex, nofollow, nosnippet

/scripts/*
  X-Robots-Tag: noindex, nofollow, nosnippet

/AGENTS.md
  X-Robots-Tag: noindex, nofollow, nosnippet

/CLAUDE.md
  X-Robots-Tag: noindex, nofollow, nosnippet

/README.md
  X-Robots-Tag: noindex, nofollow, nosnippet

/package.json
  X-Robots-Tag: noindex, nofollow, nosnippet

/_headers
  X-Robots-Tag: noindex, nofollow, nosnippet
